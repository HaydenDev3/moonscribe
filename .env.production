# Production values for browser and packaged desktop builds.
# This file intentionally overrides developer-only .env.local values during
# `vite build`, so release artifacts never point at localhost services.
VITE_MOONSCRIBE_ENV=production
VITE_MOONSCRIBE_WEB_URL=https://www.moonscribe.cc
VITE_MOONSCRIBE_API_URL=https://www.moonscribe.cc
VITE_API_URL=https://www.moonscribe.cc
VITE_APP_URL=https://www.moonscribe.cc
