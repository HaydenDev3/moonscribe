# Copy this file to .env.local for local development. Never commit .env.local.
# `npm run dev` loads .env.local for the MoonScribe server. Configure the same
# server-only values in your deployment provider's encrypted environment settings.

# ---- Required in production -------------------------------------------------

# Public URL where writers use MoonScribe. No trailing slash.
# Used for secure CORS checks, OAuth callbacks, and links in verification email.
# Production: https://moonscribe.cc
# Local development: http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Public origin of the shared Cloud API. OAuth provider callbacks must point
# here; the API then returns users to APP_ORIGIN or moonscribe://auth/callback.
API_ORIGIN=http://localhost:3001

# Cryptographically random secret used to sign one-use OAuth state values.
# Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep this server-only. Never prefix it with VITE_.
OAUTH_STATE_SECRET=

# Persistent directory for the server's SQLite database. Back this directory up.
# Use an absolute, writable volume path in production.
DATA_DIR=./data

# ---- Email delivery with Resend (required for verification and email 2FA) ---

# Create an API key at https://resend.com/api-keys with sending permission.
# Keep it server-only; do NOT use VITE_RESEND_API_KEY.
RESEND_API_KEY=

# The sender is fixed in the application to the verified MoonScribe domain.
# RESEND_FROM_EMAIL is intentionally ignored so test overrides cannot send
# from an unowned domain.
RESEND_FROM_EMAIL=MoonScribe <noreply@moonscribe.cc>

# Optional production update manifest. The matching updater public key belongs
# in the Tauri config; keep the private signing key in CI secret storage only.
MOONSCRIBE_UPDATE_ENDPOINT=https://updates.moonscribe.cc/{{target}}/{{arch}}/{{current_version}}
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ---- Optional OAuth sign-in -------------------------------------------------

# Create an application at https://discord.com/developers/applications.
# Add this redirect URL: https://your-api-domain/auth/discord/callback
# The client ID is public, but keep the secret server-only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Create OAuth credentials at https://console.cloud.google.com/apis/credentials.
# Add this redirect URL: https://your-api-domain/auth/google/callback
# Keep the client secret server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Hosting and reverse proxy ---------------------------------------------

# Comma-separated additional browser origins allowed to call the API.
# APP_ORIGIN is always allowed. Leave blank unless you use a separate web host.
# Example: https://www.your-domain.com,https://staging.your-domain.com
CORS_ORIGINS=

# Set true only when a trusted reverse proxy (for example Render, Fly, Nginx,
# or Cloudflare) supplies X-Forwarded-For. This makes rate limiting use client IPs.
TRUST_PROXY=false

# Change only when intentionally exposing the server on another port.
PORT=3001

# Server-side owner bootstrap. This Discord account receives Admin on restart.
MOONSCRIBE_ADMIN_DISCORD_ID=622903645268344835

# Allow temporary ngrok/localtunnel origins in development. Keep false in production.
ALLOW_DEV_TUNNELS=false

# One-time migration switch for an old unowned server database. Leave false for
# new deployments; turn on only for the first account during a planned migration.
CLAIM_LEGACY_RECORDS_ON_FIRST_ACCOUNT=false

# ---- Optional Supabase migration helper (public browser configuration) -----

# Create a project at https://supabase.com/dashboard, then copy the Project URL
# and the publishable/anon key from Project Settings > API. These VITE_ values
# are intentionally public browser configuration, not service-role secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Railway-only server persistence. Never expose this through VITE_ or
# NEXT_PUBLIC_ variables. The startup migration is one-way and idempotent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_MIGRATE_ON_STARTUP=false

# Optional when the Vite app and sync server use different origins. Do not set
# for same-origin production hosting; APP_ORIGIN is then used automatically.
# Example: https://api.your-domain.com
VITE_SYNC_SERVER=
VITE_AD_FREE_USERNAMES=Storm Tattersall,storm
# Canonical shared MoonScribe Cloud endpoints. Packaged desktop builds default
# to these production hostnames; set explicitly for staging/custom deployment.
VITE_API_URL=
VITE_APP_URL=
# Optional published desktop installer URLs. Windows defaults to the bundled
# /downloads/MoonScribe_0.1.0_x64-setup.exe artifact when omitted.
VITE_DOWNLOAD_WINDOWS_URL=
VITE_DOWNLOAD_MACOS_URL=
VITE_DOWNLOAD_LINUX_URL=

# BabyLoveGrowth article integration. Keep the API key server-only.
BABYLOVEGROWTH_API_KEY=
BABYLOVEGROWTH_INTEGRATION_ID=f9d81211-21a1-4815-a6c2-12f7fafe69d3
BABYLOVEGROWTH_SYNC_INTERVAL_MS=21600000
