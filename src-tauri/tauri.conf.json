{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MoonScribe",
  "version": "1.1.3",
  "identifier": "com.moonscribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MoonScribe",
        "width": 1440,
        "height": 950,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http: https: data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://localhost:* ws://localhost:* https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MoonScribe",
    "category": "Productivity",
    "shortDescription": "A private writing studio for long-form fiction and book design.",
    "longDescription": "MoonScribe is a local-first writing studio for authors who want a calm place to draft, plan, design, and export without losing privacy.",
    "copyright": "© 2026 MoonScribe",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md"], "mimeType": "text/markdown", "description": "MoonScribe Markdown manuscript" },
      { "ext": ["markdown"], "mimeType": "text/markdown", "description": "MoonScribe Markdown manuscript" },
      { "ext": ["docx"], "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "description": "MoonScribe Word manuscript" },
      { "ext": ["epub"], "mimeType": "application/epub+zip", "description": "MoonScribe EPUB manuscript" },
      { "ext": ["json"], "mimeType": "application/json", "description": "MoonScribe backup" }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.moonscribe.cc/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_PRODUCTION_TAURI_PUBLIC_KEY"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["moonscribe"]
      }
    }
  }
}
